{
  "name": "flout",
  "version": "0.1.1",
  "type": "module",
  "description": "Manage persistent AI agent sessions with tmux",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "flout": "./bin/flout.js"
  },
  "files": [
    "dist/src",
    "bin"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "tsx --test test/e2e/*.e2e.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bgrgicak/flout.git",
    "directory": "packages/flout"
  },
  "homepage": "https://github.com/bgrgicak/flout",
  "author": "Bero",
  "keywords": [
    "tmux",
    "agent",
    "session",
    "claude",
    "ai",
    "cli",
    "persistent"
  ],
  "dependencies": {
    "@flout/claude": "*",
    "@flout/docker": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-2.0-only",
  "devDependencies": {
    "@flout/claude-mock-api": "*",
    "tsx": "^4.21.0"
  }
}
